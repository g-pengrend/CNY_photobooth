# ========================================================
# SEIT Photobooth - DGX A100 Full-Stack Dockerfile
# Ubuntu 22.04 + CUDA 12.4 + PyTorch 2.4 + ComfyUI
# ========================================================
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV DEPLOY_MODE=local

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-dev \
    git \
    wget \
    curl \
    tmux \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.4
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/cu124

# Clone ComfyUI repository
RUN git clone https://github.com/comfyanonymous/ComfyUI.git /app/ComfyUI \
    && pip3 install --no-cache-dir -r /app/ComfyUI/requirements.txt

# Copy Photobooth requirements and install
COPY requirements_server.txt /app/requirements_server.txt
COPY requirements_client.txt /app/requirements_client.txt
RUN pip3 install --no-cache-dir -r /app/requirements_server.txt || true
RUN pip3 install --no-cache-dir -r /app/requirements_client.txt || true

# Copy project source files
COPY kiosk_frontend /app/kiosk_frontend
COPY dgx_photobooth /app/dgx_photobooth
COPY config.py /app/config.py
COPY print_agent.py /app/print_agent.py
COPY deploy/docker/entrypoint.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh

# Expose all 4 core ports
EXPOSE 5000 5001 8188 8189

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
