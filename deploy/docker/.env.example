# ========================================================
# SEIT Photobooth - DGX Deployment Environment Config
# Copy this file to .env on the DGX host: cp .env.example .env
# ========================================================

# Host root storage directory (NVMe / RAID storage)
DATA_DIR=/raid/photobooth

# Web & Receiver Security
THEME_STUDIO_PASSWORD=admin
DEPLOY_MODE=local

# Public Domain Endpoint (Optional but recommended for Production):
# If set, mobile download QR codes will encode this domain directly.
# (e.g. PUBLIC_URL=https://photobooth.institution.edu.sg)
# If left blank, an ad-hoc Cloudflare Tunnel (trycloudflare.com) will start automatically.
PUBLIC_URL=

# GPU Allocation Strategy:
# By default, detection is 100% AUTOMATIC:
# - If 2+ GPUs detected: GPU 0 -> Image (8188), GPU 1 -> Video (8189)
# - If 1 GPU detected:   Both pipelines automatically run on GPU 0
# Uncomment and set only if you need to manually force specific GPU IDs on a shared node:
# GPU_IMAGE_DEVICE=0
# GPU_VIDEO_DEVICE=1

# Exposed Host Ports
PORT_FRONTEND=5000
PORT_RECEIVER=5001
PORT_COMFY_IMAGE=8188
PORT_COMFY_VIDEO=8189
